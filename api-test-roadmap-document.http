### View Road Map List
# Expected response sample:
# HTTP/1.1 200
# [
#   {
#     "id": 1,
#     "learningSpaceId": 1,
#     "lecturerId": 1,
#     "title": "Roadmap 1",
#     "description": "Roadmap description",
#     "status": "ACTIVE",
#     "position": 1,
#     "createdAt": "2026-05-22T10:00:00",
#     "updatedAt": "2026-05-22T10:00:00"
#   }
# ]
GET {{baseUrl}}/api/learning-spaces/{{learningSpaceId}}/learning-paths
Accept: application/json

### View Document List
# Expected response sample:
# HTTP/1.1 200
# [
#   {
#     "id": 1,
#     "learningPathId": 1,
#     "title": "Document 1",
#     "documentType": "PDF",
#     "url": "https://example.com/document.pdf",
#     "description": "Document description",
#     "createdAt": "2026-05-22T10:00:00"
#   }
# ]
GET {{baseUrl}}/api/learning-paths/{{learningPathId}}/documents
Accept: application/json

